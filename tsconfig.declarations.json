{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "./src/lib",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/lib/**/*.ts",
    "src/lib/**/*.svelte"
  ]
}
