{
  "name": "zdp-auth-ui",
  "version": "0.8.9",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "description": "ZDP shared authentication UI package for Astro, SvelteKit, and Tauri Svelte surfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/zdp-auth-ui.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/zdp-auth-ui/issues"
  },
  "homepage": "https://github.com/0disoft/zdp-auth-ui#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": {
        "browser": "./dist/index.js",
        "default": "./dist/index.server.js"
      },
      "browser": "./dist/index.js",
      "node": "./dist/index.server.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./i18n/loader": {
      "types": "./dist/i18n/loader.d.ts",
      "import": "./dist/i18n/loader.js",
      "default": "./dist/i18n/loader.js"
    },
    "./i18n/en": {
      "types": "./dist/i18n/en.d.ts",
      "import": "./dist/i18n/en.js",
      "default": "./dist/i18n/en.js"
    },
    "./i18n/zh": {
      "types": "./dist/i18n/zh.d.ts",
      "import": "./dist/i18n/zh.js",
      "default": "./dist/i18n/zh.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "import": "./dist/i18n/es.js",
      "default": "./dist/i18n/es.js"
    },
    "./i18n/fr": {
      "types": "./dist/i18n/fr.d.ts",
      "import": "./dist/i18n/fr.js",
      "default": "./dist/i18n/fr.js"
    },
    "./i18n/hi": {
      "types": "./dist/i18n/hi.d.ts",
      "import": "./dist/i18n/hi.js",
      "default": "./dist/i18n/hi.js"
    },
    "./i18n/ko": {
      "types": "./dist/i18n/ko.d.ts",
      "import": "./dist/i18n/ko.js",
      "default": "./dist/i18n/ko.js"
    },
    "./i18n/ja": {
      "types": "./dist/i18n/ja.d.ts",
      "import": "./dist/i18n/ja.js",
      "default": "./dist/i18n/ja.js"
    },
    "./i18n/vi": {
      "types": "./dist/i18n/vi.d.ts",
      "import": "./dist/i18n/vi.js",
      "default": "./dist/i18n/vi.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "import": "./dist/i18n/ru.js",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/id": {
      "types": "./dist/i18n/id.d.ts",
      "import": "./dist/i18n/id.js",
      "default": "./dist/i18n/id.js"
    },
    "./i18n/ms": {
      "types": "./dist/i18n/ms.d.ts",
      "import": "./dist/i18n/ms.js",
      "default": "./dist/i18n/ms.js"
    },
    "./i18n/th": {
      "types": "./dist/i18n/th.d.ts",
      "import": "./dist/i18n/th.js",
      "default": "./dist/i18n/th.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "BOUNDARY.md",
    "RUNBOOK.md",
    "SECURITY.md",
    "service.yaml",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "auth-handoff:generate": "bun scripts/generate-auth-handoff-registry.ts",
    "auth-handoff:check": "bun scripts/generate-auth-handoff-registry.ts --check",
    "build": "vite build && vite build --config vite.server.config.ts && bun scripts/preserve-server-component-identity.ts && bun scripts/build-package-surface.ts && bun scripts/check-ssr-package-surface.ts",
    "build:bundle": "vite build && vite build --config vite.server.config.ts",
    "browser:check": "node scripts/check-browser-accessibility.mjs && node scripts/check-auth-shell-busy.mjs && node scripts/check-auth-feedback-browser.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && bun scripts/check-bun-registry-lock.ts && bun scripts/check-product-link-contract.ts && bun scripts/check-auth-handoff-contract.ts && bun scripts/check-passkey-progressive-enhancement.ts && bun scripts/check-auth-ui.ts && bun scripts/check-package-types.ts && bun run --conditions development scripts/check-dev-ssr-consumer.mjs && bun run release:check",
    "release:artifact:check": "bun scripts/build-release-artifact.ts --check",
    "release:check": "bun scripts/check-release-workflow.ts && bun run release:artifact:check",
    "package:check": "bun run check"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "zdp-design-system": "^0.63.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.3",
    "playwright-core": "1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "svelte": "^5.56.0"
  }
}
