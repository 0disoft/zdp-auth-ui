{
  "name": "zdp-auth-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ZDP shared authentication UI package for Astro, SvelteKit, and Tauri Svelte surfaces.",
  "exports": {
    ".": {
      "svelte": "./src/lib/index.ts",
      "types": "./src/lib/index.ts",
      "default": "./src/lib/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./i18n": {
      "types": "./src/lib/i18n.ts",
      "import": "./src/lib/i18n.ts",
      "default": "./src/lib/i18n.ts"
    },
    "./contract": {
      "types": "./src/lib/auth-contract.ts",
      "import": "./src/lib/auth-contract.ts",
      "default": "./src/lib/auth-contract.ts"
    }
  },
  "files": [
    "src/",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./src/styles/index.css"
  ],
  "scripts": {
    "build": "vite build",
    "check": "bun scripts/check-auth-ui.ts",
    "package:check": "bun scripts/check-auth-ui.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "zdp-design-system": "file:../zdp-design-system"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.12.4",
    "svelte": "^5.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
