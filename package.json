{
  "name": "zdp-auth-ui",
  "version": "0.1.12",
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "ZDP shared authentication UI package for Astro, SvelteKit, and Tauri Svelte surfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/zdp-auth-ui.git"
  },
  "bugs": {
    "url": "https://github.com/0disoft/zdp-auth-ui/issues"
  },
  "homepage": "https://github.com/0disoft/zdp-auth-ui#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "BOUNDARY.md",
    "RUNBOOK.md",
    "SECURITY.md",
    "service.yaml",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "vite build && bun scripts/build-package-surface.ts",
    "build:bundle": "vite build",
    "browser:check": "node scripts/check-browser-accessibility.mjs",
    "check": "bun scripts/check-bun-registry-lock.ts && bun scripts/check-auth-ui.ts && bun run release:check",
    "release:artifact:check": "bun scripts/build-release-artifact.ts --check",
    "release:check": "bun scripts/check-release-workflow.ts && bun run release:artifact:check",
    "package:check": "bun run check"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "zdp-design-system": "^0.46.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^24.12.4",
    "playwright-core": "1.61.1",
    "svelte": "^5.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "peerDependencies": {
    "svelte": "^5.56.0"
  }
}
